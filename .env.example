# Copy to .env (gitignored) and fill in.

# Management API keys — format pk_<uuid>_<secret>, sent as the X-Polyant-Key header.
# Org-scoped, and carrying an explicit permission set: a key can only do what it
# was granted. Create them in the admin panel. This is what polyant-cli
# authenticates with; the variable NAME is what polyant.yaml's `keyEnv` points at.
POLYANT_KEY_STAGING=
POLYANT_KEY_PROD=

# Per-agent runtime key, sent as Authorization: Bearer. It authenticates traffic
# TO ONE AGENT on its chat endpoint and its HTTP channel — a different mechanism
# from the management keys above, and polyant-cli never sends it. Set it when you
# call an agent directly (curl, your own app). Confusing the two gets you a 403
# you cannot diagnose from either side alone.
POLYANT_AGENT_KEY=
