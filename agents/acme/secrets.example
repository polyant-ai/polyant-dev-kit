# Secret KEY NAMES this agent needs. Never values — not even a placeholder that
# looks like one. Set the values in the admin panel, or with
# `api PUT /api/instances/acme/secrets`, and keep this file as the checklist.
#
# Which keys appear here is decided by what the agent has enabled: every tool and
# skill declares its own `requiredSecrets`. Ask the instance rather than guessing:
#   api GET /api/instances/acme/tools/required-secrets

# Chat completions for the agent's configured provider. On OSS this is an agent
# secret; on Polyant Enterprise it is a connection bound to the agent's chat role,
# and the secret write refuses it.
openai_api_key

# Embeddings, memory and knowledge. Same key when the embedder is OpenAI; the
# Bedrock embedder uses the aws_provider_* set instead. On Enterprise, the
# embedding role's connection.

# The webSearch tool.
tavily_api_key

# The bearer token callers must send to this agent's chat endpoint, when the
# agent has authEnabled on.
auth_api_key
